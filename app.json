{
  "expo": {
    "name": "StudyMate",
    "slug": "StudyMate",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "studymate",
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF"
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "com.yourcompany.studymate"
    },
    "android": {
      "package": "com.yourcompany.studymate",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "studymate"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ]
    }
  }
}