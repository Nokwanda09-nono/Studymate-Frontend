{
  "expo": {
    "name": "StudyMate",
    "slug": "StudyMate",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "studymate",
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#208AEF"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "backgroundColor": "#208AEF"
        }
      ],
      "expo-sharing",
      "expo-image",
      "expo-web-browser"
    ],
    "ios": {
      "bundleIdentifier": "com.yourcompany.studymate"
    },
    "android": {
      "package": "com.yourcompany.studymate",
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "studymate"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    }
  }
}
